def COLOR_MAP = [
  SUCCESS: 'good',
  FAILURE: 'danger',
  ABORTED: 'warning',
  UNSTABLE: 'warning',
  NOT_BUILT: 'warning'
]
pipeline {
  agent any
  tools {
    nodejs 'NODE24'
  }
  environment {
    SHELL = '/bin/bash'
  }
  options {
    timeout(time: 30, unit: 'MINUTES')
  }
  stages {
    stage('Preparation') {
      steps {
        echo 'Check dependencies and prepare environment...'
        sh 'node -v'
        sh 'npm -v'
        sh "mongodump --version"
      }
    }
    stage('Fetching code') {
      steps {
        git url: 'https://github.com/DomenicoTe/myapp.git', branch: 'jenkins'
      }
      post {
        success {
          echo 'Code fetched successfully.'
        }
        failure {
          echo 'Failed to fetch code. Please check the repository URL and branch name.'
        }
      }
    }
    stage('Install dependencies') {
      steps {
        sh 'npm ci'
      }
      post {
        success {
          echo 'Dependencies installed successfully.'
        }
        failure {
          echo 'Failed to install dependencies. Please check the npm logs for details.'
        }
      }
    }
    stage('Testing') {
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          sh 'npm test -- --coverage'
          sh 'test -s coverage/lcov.info'
        }
      }
      post {
        success {
          echo 'Tests passed successfully.'
        }
        failure {
          echo 'Tests failed. Please check the test logs for details.'
        }
      }
    }
    stage('Code Analysis ESLint') {
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          sh '''
            npm run lint:report
            test -s eslint-report.json
          '''
        }
      }
      post {
        success {
          echo 'Code analysis completed successfully.'
        }
      }
    }
    stage('Code Analysis SonarQube') {
      steps {
        script {
          def scannerHome = tool 'SQUBE8.1'
          withSonarQubeEnv('SonarServer') {
            sh """
              ${scannerHome}/bin/sonar-scanner \
                -Dsonar.projectKey=${env.JOB_NAME} \
                -Dsonar.projectName=${env.JOB_NAME}-jenkins \
                -Dsonar.projectVersion=1.0 \
                -Dsonar.sources=. \
                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                -Dsonar.javascript.eslint.reportPaths=eslint-report.json \
                -Dsonar.exclusions=coverage/**,dist/**,node_modules/** 
            """
          }
        }
      }
    }
    stage('Quality Gate') {
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
      post {
        success {
          echo 'Quality gate passed successfully.'
        }
        failure {
          echo 'Quality gate failed. Please check the SonarQube dashboard for details.'
        }
      }
    }
    stage('Build') {
      steps {
        timeout(time: 15, unit: 'MINUTES') {
          sh 'npm run build'
        }
      }
      post {
        success {
          echo 'Build completed successfully.'
        }
        failure {
            echo 'Build failed. Please check the build logs for details.'
        }
      }
    }
    stage('Compress as tgz') {
      steps {
        sh """
          tar -czf ${env.JOB_NAME}_${env.BUILD_NUMBER}.tgz dist
        """
      }
      post {
        success {
          archiveArtifacts artifacts: "${env.JOB_NAME}_${env.BUILD_NUMBER}.tgz"
        }
      }
    }
    stage('Minio Release') {
      steps {
        minio bucket: 'artifacts',
          credentialsId: 'myminio',
          host: 'http://192.168.179.119:9100/',
          includes: "${env.JOB_NAME}_${env.BUILD_NUMBER}.tgz",
          targetFolder: '/'
      }
    }
    stage('Nexus Release') {
      steps {
        nexusArtifactUploader(
          nexusVersion: 'nexus3',
          protocol: 'http',
          nexusUrl: '192.168.179.119:8081/',
          groupId: 'QA',
          version: "1.0.${env.BUILD_NUMBER}",
          repository: 'vprofile-project',
          credentialsId: 'mynexus',
          artifacts: [
              [
                artifactId: "${env.JOB_NAME}",
                classifier: '',
                file: "${env.JOB_NAME}_${env.BUILD_NUMBER}.tgz",
                type: 'tgz'
              ]
          ]
        )
      }
    }
    stage('Post-release tasks') {
      steps {
        sh """
          [ -d dist ] && rm -rf dist
          [ -f ${env.JOB_NAME}_${env.BUILD_NUMBER}.tgz ] && rm -f ${env.JOB_NAME}_${env.BUILD_NUMBER}.tgz
        """
      }
      post {
        success {
          echo 'Post-release tasks completed successfully.'
        }
      }
    }
  }
  post {
    always {
      echo 'Sending notification...'
      slackSend(
        channel: '#sns-jenkins',
        color: COLOR_MAP[currentBuild.currentResult],
        message: "Build ${env.JOB_NAME} #${env.BUILD_NUMBER} - ${currentBuild.currentResult}\n${env.BUILD_URL}\n"
      )
    }
  }
}