def COLOR_MAP = [
  SUCCESS: 'good',
  FAILURE: 'danger',
  ABORTED: 'warning',
  UNSTABLE: 'warning',
  NOT_BUILT: 'warning'
]
pipeline {
  agent any
  tools {
    nodejs 'NODE24'
  }
  environment {
    SHELL = '/bin/bash'
    image = "158394349423.dkr.ecr.us-east-1.amazonaws.com/myapp"
    registry = "https://158394349423.dkr.ecr.us-east-1.amazonaws.com"
    registryCredential="ecr:us-east-1:myaws"
  }
  options {
    timeout(time: 30, unit: 'MINUTES')
  }
  stages {
    stage('Preparation') {
      steps {
        echo 'Check dependencies and prepare environment...'
        sh 'node -v'
        sh 'npm -v'
      }
    }
    stage('Fetching code') {
      steps {
        git url: 'https://github.com/DomenicoTe/myapp.git', branch: 'jdocker'
      }
    }
    stage('Install dependencies') {
      steps {
        sh 'npm ci'
      }
    }
    stage('Testing') {
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          sh 'npm test -- --coverage'
          sh 'test -s coverage/lcov.info'
        }
      }
    }
    stage('Code Analysis ESLint') {
      steps {
          sh '''
            npm run lint:report
            test -s eslint-report.json
          '''
      }
    }
    stage('Code Analysis SonarQube') {
      steps {
        script {
          def scannerHome = tool 'SQUBE8.1'
          withSonarQubeEnv('SonarServer') {
            sh """
              ${scannerHome}/bin/sonar-scanner \
                -Dsonar.projectKey=${env.JOB_NAME} \
                -Dsonar.projectName=${env.JOB_NAME}-jenkins \
                -Dsonar.projectVersion=1.0 \
                -Dsonar.sources=. \
                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                -Dsonar.javascript.eslint.reportPaths=eslint-report.json \
                -Dsonar.exclusions=coverage/**,dist/**,node_modules/** 
            """
          }
        }
      }
    }
    stage('Quality Gate') {
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }
    stage('Build') {
      steps {
        timeout(time: 15, unit: 'MINUTES') {
          sh 'npm run build'
        }
      }
      post {
        success {
          echo 'Build completed successfully.'
        }
        failure {
            echo 'Build failed. Please check the build logs for details.'
        }
      }
    }
    stage('Docker Build'){
      steps {
        script {
          dockerImage = docker.build( image + ":v1.0.${env.BUILD_NUMBER}", "-f Dockerfile .")
        }
      }
    }
    stage('Docker Push Nexus'){
      steps {
        script {
          docker.withRegistry(registry, registryCredential) {
            dockerImage.push("v1.0.${env.BUILD_NUMBER}")
            dockerImage.push("latest")
          }
        }
      }
    }
  }
  post {
    always {
      echo 'Sending notification...'
      slackSend(
        channel: '#sns-jenkins',
        color: COLOR_MAP[currentBuild.currentResult],
        message: "Build ${env.JOB_NAME} #${env.BUILD_NUMBER} - ${currentBuild.currentResult}\n${env.BUILD_URL}\n"
      )
    }
  }
}