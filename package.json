{
  "name": "myapp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "myapp": "./index.js"
  },
  "scripts": {
    "up:major": "npm version major -m \"Bump major version to %s\"",
    "up:minor": "npm version minor -m \"Bump minor version to %s\"",
    "up:patch": "npm version patch -m \"Bump patch version to %s\"",
    "up:dev": "npm version prerelease --preid=dev -m \"Bump dev version to %s\"",
    "extensions": "node extensions",
    "packages": "node packages",
    "start": "nodemon index.js",
    "cicd": "npm ci",
    "build": "pkg . --targets node24-linux-x64 --out-path dist",
    "post-release": "node bin post-release",
    "test": "jest",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@myapp/debug": "1.0.1",
    "@yao-pkg/pkg": "^6.19.0",
    "commander": "^10.0.1",
    "dotenv": "^16.0.0",
    "eslint": "^10.2.1",
    "express": "^4.17.1",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "joi": "^17.0.0",
    "nodemon": "^3.1.14",
    "shelljs": "^0.10.0",
    "supertest": "^7.2.2"
  },
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "dependencies": {
    "@myapp/module_check": "1.0.0",
    "@myapp/module_update": "1.0.0",
    "@myapp/plugin_counter": "1.0.0",
    "@myapp/plugin_hello": "1.0.0",
